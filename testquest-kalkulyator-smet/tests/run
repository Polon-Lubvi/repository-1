#!/usr/bin/env node
/*
 * Автотесты раздела «Калькулятор смет» TestQuest.
 * Рантайм: Node.js 18+ (встроенный fetch), без внешних зависимостей.
 * Файл без расширения — запускается как `node tests/run` (CommonJS).
 *
 *   BASE_URL=https://testquest.pryaniky.com node tests/run
 *
 * Код выхода: 0 = PASSED, 1 = FAILED, 2 = ошибка окружения.
 */
"use strict";

const BASE_URL = (process.env.BASE_URL || "https://testquest.pryaniky.com").replace(/\/+$/, "");
const NO_COLOR = process.env.NO_COLOR || !process.stdout.isTTY;
const g = (s) => (NO_COLOR ? s : `\x1b[32m${s}\x1b[0m`);
const r = (s) => (NO_COLOR ? s : `\x1b[31m${s}\x1b[0m`);
const bld = (s) => (NO_COLOR ? s : `\x1b[1m${s}\x1b[0m`);

// ---------------------------------------------------------------------------
// Загрузка ресурсов стенда (с кэшем в рамках прогона)
// ---------------------------------------------------------------------------
const cache = new Map();
async function fetchText(path) {
  if (cache.has(path)) return cache.get(path);
  const url = path.startsWith("http") ? path : BASE_URL + path;
  const res = await fetch(url, { headers: { "User-Agent": "TestQuest-QA-kit/1.0" } });
  if (!res.ok) throw new Error(`HTTP ${res.status} для ${url}`);
  const txt = await res.text();
  cache.set(path, txt);
  return txt;
}
const js = (name) => fetchText(`/js/${name}.js`);
const html = () => fetchText("/");

// ---------------------------------------------------------------------------
// Разбор констант из js/data.js
// ---------------------------------------------------------------------------
async function dataConstants() {
  if (cache.has("consts")) return cache.get("consts");
  const src = await js("data");

  const baseValues = [];
  for (const m of src.match(/baseValues\s*:\s*\[(.*?)\]/s)[1].matchAll(
    /variant\s*:\s*(\d+)\s*,\s*baseCloudPrice\s*:\s*([\d.]+)\s*,\s*baseYearSupportFee\s*:\s*([\d.]+)/g
  )) baseValues.push({ variant: +m[1], baseCloudPrice: +m[2], baseYearSupportFee: +m[3] });

  const priceDivisors = [];
  for (const m of src.match(/priceDivisors\s*:\s*\[(.*?)\]/s)[1].matchAll(
    /PriceTag\s*:\s*(\d+)\s*,\s*Divisor\s*:\s*([\d.]+)/g
  )) priceDivisors.push({ tag: +m[1], divisor: +m[2] });

  const termDiscounts = [];
  for (const m of src.match(/termDiscounts\s*:\s*\[(.*?)\]/s)[1].matchAll(
    /minTerm\s*:\s*(\d+)\s*,\s*discount\s*:\s*([\d.]+)/g
  )) termDiscounts.push({ minTerm: +m[1], discount: +m[2] });

  const tmRate = +src.match(/TM_HOURLY_RATE\s*:\s*(\d+)/)[1];
  const tmHours = +src.match(/TM_DEFAULT_HOURS\s*:\s*(\d+)/)[1];

  const managers = [];
  for (const m of src.match(/KP_MANAGERS\s*:\s*\[(.*?)\]\s*,\s*MODULE_GROUPS/s)[1].matchAll(
    /id:\s*'([^']+)'\s*,\s*name:\s*'([^']+)'\s*,\s*phone:\s*'([^']+)'\s*,\s*email:\s*'([^']+)'/g
  )) managers.push({ id: m[1], name: m[2], phone: m[3], email: m[4] });

  const moduleGroups = [];
  const gblock = src.match(/MODULE_GROUPS\s*:\s*\[(.*)\]\s*,?\s*\};/s)[1];
  for (const gm of gblock.matchAll(
    /\{\s*id:\s*'([^']+)',\s*title:\s*'([^']*)',\s*coefAdd:\s*([\d.]+),\s*modules:\s*\[(.*?)\]\s*,?\s*\}/gs
  )) {
    const mods = [];
    for (const mm of gm[4].matchAll(/\{([^}]*)\}/g)) {
      const body = mm[1];
      mods.push({
        id: body.match(/id:\s*'([^']+)'/)[1],
        mandatory: /mandatory:\s*true/.test(body),
        coefAdd: body.match(/coefAdd:\s*([\d.]+)/) ? +body.match(/coefAdd:\s*([\d.]+)/)[1] : null,
      });
    }
    moduleGroups.push({ id: gm[1], title: gm[2], coefAdd: +gm[3], modules: mods });
  }

  const presets = [];
  const iblock = src.match(/IMPLEMENTATION_PRESET_GROUPS\s*:\s*\[(.*?)\]\s*,\s*KP_MANAGERS/s)[1];
  for (const it of iblock.matchAll(/\{\s*id:\s*'([^']+)',\s*label:\s*'((?:[^'\\]|\\.)*)'(.*?)\}/gs)) {
    const tail = it[3];
    presets.push({
      id: it[1],
      label: it[2],
      pricing: (tail.match(/pricing:\s*'([^']+)'/) || [, "custom"])[1],
      defaultPrice: tail.match(/defaultPrice:\s*(\d+)/) ? +tail.match(/defaultPrice:\s*(\d+)/)[1] : null,
      onPremOnly: /onPremOnly:\s*true/.test(tail),
    });
  }

  const out = { baseValues, priceDivisors, termDiscounts, tmRate, tmHours, managers, moduleGroups, presets };
  cache.set("consts", out);
  return out;
}

// ---------------------------------------------------------------------------
// Порт движка ценообразования (js/calc.js), сверен со стендом
// ---------------------------------------------------------------------------
const TARIFF_CLOUD = 0;
const TARIFF_BOX = 1;

function termDiscount(term, td) {
  const ap = td.filter((d) => d.minTerm <= term).map((d) => d.discount);
  return ap.length ? 1 - Math.max(...ap) / 100 : 1;
}

function calcLicenses(tariff, licenceCount, termMonths, coefficient, k, variant) {
  coefficient = coefficient == null ? 1 : coefficient;
  variant = variant || 0;
  const divisors = k.priceDivisors.map((d) => d.divisor);
  const baseRow = k.baseValues.find((b) => b.variant === variant);
  if ((termMonths === 0 || licenceCount === 0) && tariff === TARIFF_CLOUD) return 0;

  const calcTerm = tariff === TARIFF_BOX ? 24 : termMonths;
  const discount = termDiscount(calcTerm, k.termDiscounts);
  const tail = licenceCount % 100;
  const rows = Array((licenceCount - tail) / 100).fill(100).concat([tail]);
  const basePrice = baseRow.baseCloudPrice * coefficient;
  const supportFee = baseRow.baseYearSupportFee;

  let cur = 0, monthSum = 0;
  rows.forEach((cnt, i) => {
    cur += 100;
    const dc = i < divisors.length ? 1 / Math.sqrt(divisors[i]) : 1 / Math.sqrt(cur / 100);
    monthSum += basePrice * dc * cnt;
  });

  let total = monthSum * calcTerm * discount;
  if (tariff === TARIFF_BOX) {
    const magisterBase = total / (1 + supportFee / 100);
    const supportYears = termMonths ? Math.ceil(termMonths / 12) : 0;
    let sc = 1;
    if (supportYears > 1) sc = 1 + (supportFee / 100) * (supportYears - 1);
    total = magisterBase * sc;
  }
  return Math.round(total);
}

function modulesCoefficient(selectedIds, giftIds, k) {
  const gift = new Set(giftIds || []);
  let adds = 0;
  for (const grp of k.moduleGroups)
    for (const m of grp.modules)
      if (selectedIds.includes(m.id) && !gift.has(m.id) && !m.mandatory)
        adds += m.coefAdd != null ? m.coefAdd : grp.coefAdd;
  return Math.round((1 + adds) * 100) / 100;
}

function implGross(net, vatRate) {
  vatRate = vatRate == null ? 5 : vatRate;
  net = Math.round(net);
  const vat = Math.round((net * vatRate) / 100);
  return { net, vat, gross: net + vat };
}

const tmAmount = (hours, k) => hours * k.tmRate;
const fmtRub = (v) => new Intl.NumberFormat("ru-RU", { style: "currency", currency: "RUB", maximumFractionDigits: 0 }).format(Math.round(v));
const normWs = (t) => String(t).replace(/[\s   ]+/g, " ").trim();

// ---------------------------------------------------------------------------
// Мини-ассерты
// ---------------------------------------------------------------------------
class Checks {
  constructor() { this.items = []; }
  ok(name, cond, info) { this.items.push({ name, ok: !!cond, info: info || "" }); }
  eq(name, a, e, info) {
    const good = JSON.stringify(a) === JSON.stringify(e);
    this.items.push({ name, ok: good, info: info || (good ? JSON.stringify(a) : `получено ${JSON.stringify(a)}, ожидалось ${JSON.stringify(e)}`) });
  }
  near(name, a, e, tol, info) {
    tol = tol == null ? 1 : tol;
    this.items.push({ name, ok: Math.abs(a - e) <= tol, info: info || `${a} ~ ${e} (±${tol})` });
  }
  has(name, hay, needle, info) {
    const good = hay.includes(needle);
    this.items.push({ name, ok: good, info: info || (good ? `нашли ${JSON.stringify(needle)}` : `НЕ нашли ${JSON.stringify(needle)}`) });
  }
}

