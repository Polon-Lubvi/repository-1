    c.has("Счёт: ИНН 10 или 12 цифр", invoice, "10 или 12 цифр");
    c.ok("Счёт: регэксп ИНН в коде", /\\d\{10\}/.test(invoice) && /\\d\{12\}/.test(invoice));
    c.has("Счёт: требуется юр. название", invoice, "Укажите юридическое название заказчика");
    c.has("Акт: требуется номер акта", act, "Укажите номер акта");
    c.has("Акт: требуется дата акта", act, "Укажите дату акта");
    c.has("Акт: требуются реквизиты заказчика", act, "Укажите реквизиты заказчика");
    c.has("Акт: выбор типа (работы / передача прав)", page, 'value="rights"');
    c.has("Договор: требуется номер договора", contract, "Укажите номер договора");
    c.has("Договор: требуется дата договора", contract, "Укажите дату договора");
    c.has("Договор: требуется размер пакета лицензий", contract, "Укажите размер пакета лицензий");
    c.has("Договор: требуется стоимость пакета лицензий", contract, "Укажите стоимость пакета лицензий");
    c.eq("Облако: 0 лицензий -> 0 ₽", calcLicenses(0, 0, 12, 1, k), 0);
    c.eq("Облако: срок 0 мес -> 0 ₽", calcLicenses(0, 100, 0, 1, k), 0);
    c.has("В calc.js защита (term==0 || licenceCount==0) для Облака", calc.replace(/ /g, ""), "termMonths===0||licenceCount===0");
    c.has("Числовые поля чистятся от нецифровых символов", app, "replace(/\\D/g, '')");
    c.has("BUG-4: «К-т роста г/г» без валидации (getGrowthCoefficient)", app, "getGrowthCoefficient");
    c.eq("BUG-4 следствие: коэф. роста 0 обнуляет смету", calcLicenses(0, 100, 12, 0, k), 0);
    const metaGuard = ["Укажите компанию", "Заполните название компании"].some((s) => app.includes(s));
    c.ok("BUG-1 канарейка: экспорт Excel не валидирует мета-поля КП", !metaGuard, "нет валидации мета-полей — см. TESTCASES.md");
  }],

  ["TC-13/14 · Разметка и интеграция разделов", async (c) => {
    const k = await dataConstants();
    const page = await html();
    const mp = await js("modulesPicker");
    const contract = await js("contract");
    for (const t of ["modules", "implementation", "tm"]) c.ok(`Вкладка data-tab=${t}`, page.includes(`data-tab="${t}"`));
    for (const id of ["licenceCount", "termMonths", "coefficient", "coefficientGrowth", "discountPercent", "tmHours", "modules-container", "implementation-presets", "implementation-rows", "export-btn"])
      c.has(`Элемент #${id}`, page, `id="${id}"`);
    c.has("Общий компонент выбора модулей и в договоре", mp, "initModulesPicker");
    c.has("В договоре модули «как в калькуляторе»", page, "как в калькуляторе");
    const all = k.moduleGroups.flatMap((grp) => grp.modules.map((m) => m.id));
    c.ok("Всего модулей в каталоге = 23", all.length === 23, `их ${all.length}`);
    for (const pair of [['data-page="invoices"', "Раздел «Счета»"], ['data-page="acts"', "Раздел «Акты»"], ['data-page="contracts"', "Раздел «Договоры»"], ['data-page="client-contracts"', "Раздел «Договоры по форме клиента»"]])
      c.has(pair[1], page, pair[0]);
    c.has("Счёт: кнопка «Сформировать счёт»", page, "Сформировать счёт");
    c.has("Акт: кнопка «Сформировать акт»", page, "Сформировать акт");
    c.has("Договор: кнопка «Сформировать договор»", page, "Сформировать договор");
    c.ok("Договор различает тип продукта (SAAS/on-premise)", contract.toLowerCase().includes("saas") && contract.toLowerCase().includes("producttype"));
    c.has("В разметке договора тариф «Джедаи»", page, "Джедаи");
    c.has("В разметке договора тариф «Магистры»", page, "Магистр");
    c.has("Калькулятор оперирует ПО «Бублики»", await js("app"), "ПО «Бублики»");
  }],
];

// ---------------------------------------------------------------------------
async function main() {
  console.log(bld("== TestQuest / Калькулятор смет — прогон автотестов =="));
  console.log("BASE_URL = " + BASE_URL);
  console.log("Node     = " + process.version);
  try {
    await html();
    await js("data");
  } catch (e) {
    console.log(r("НЕ УДАЛОСЬ ОБРАТИТЬСЯ К СТЕНДУ: " + e.message));
    console.log("\nИТОГ: FAILED (стенд недоступен, код выхода 2)");
    process.exit(2);
  }

  const t0 = Date.now();
  let totalOk = 0, totalFail = 0;
  const summary = [];

  for (const entry of BLOCKS) {
    const name = entry[0], fn = entry[1];
    const c = new Checks();
    try { await fn(c); }
    catch (e) { c.ok("Блок выполнен без исключений", false, e && e.message); }
    const bo = c.items.filter((x) => x.ok).length;
    const bf = c.items.length - bo;
    totalOk += bo; totalFail += bf;
    summary.push([name, bo, bf]);
    console.log(`\n${bld("### " + name)}  [${bf === 0 ? g("OK") : r("ПАДЕНИЕ")}]  (${bo}/${bo + bf})`);
    for (const x of c.items)
      console.log(`  ${x.ok ? g("PASS") : r("FAIL")}  ${x.name}${x.info ? "  — " + x.info : ""}`);
  }

  console.log("\n" + bld("== Итоги по блокам =="));
  for (const s of summary)
    console.log(`  ${s[2] === 0 ? g("OK    ") : r("FAILED")}  ${String(s[0]).padEnd(42)} ${s[1]} pass / ${s[2]} fail`);

  const verdict = totalFail === 0 ? "PASSED" : "FAILED";
  console.log(`\n${bld(totalFail === 0 ? g(verdict) : r(verdict))}  —  ${totalOk + totalFail} проверок, ${totalOk} успешно, ${totalFail} провалено, ${((Date.now() - t0) / 1000).toFixed(1)} c`);
  console.log("ИТОГ: " + verdict);
  process.exit(totalFail === 0 ? 0 : 1);
}

main().catch((e) => {
  console.log(r("ФАТАЛЬНАЯ ОШИБКА: " + (e && e.stack || e)));
  process.exit(2);
});
