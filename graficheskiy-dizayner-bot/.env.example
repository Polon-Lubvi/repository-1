# Скопируйте этот файл в .env и заполните значения.

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# ID чата (или нескольких через запятую), куда слать ежедневную выгрузку.
# Можно оставить пустым: тогда выгрузка уходит во все чаты, где нажали /start.
TELEGRAM_CHAT_ID=

# Кому разрешено пользоваться ботом (ID пользователей Telegram через запятую).
# Пусто = любой, кто напишет боту. Узнать свой ID: команда /id в боте.
ALLOWED_USER_IDS=

# Время ежедневной выгрузки и часовой пояс (Ростов-на-Дону = Москва)
SEND_TIME=17:00
TIMEZONE=Europe/Moscow

# Ключ Claude API — тогда краткое описание, «чем интересна» и письма пишет ИИ
# и учится на ваших исправленных письмах. Без ключа работают шаблоны
# (они тоже подстраиваются под присланные письма, но проще).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Сколько вакансий максимум в одной выгрузке и за сколько дней брать свежие.
# Повторов не будет: бот помнит, что уже присылал.
MAX_VACANCIES=40
FRESH_DAYS=7
